LISTEN_HOST=0.0.0.0
LISTEN_PORT=18082
WEBHOOK_USER=alertmanager
WEBHOOK_PASSWORD_FILE=/run/secrets/webhook_password
ME_URL=https://appmanager.example.local:8443
ME_RESOURCE_ID=10000140
ME_SLOT_ATTRIBUTE_IDS=10000140:400,10000140:401,10000140:402
ME_API_KEY_FILE=/run/secrets/me_api_key
ME_VERIFY_TLS=true
ME_TIMEOUT=10
DB_PATH=/data/alerts.sqlite3
IDENTITY_MODE=instance
RETRY_SECONDS=15
SYNC_INTERVAL=30
MAX_BODY_BYTES=2097152
LOG_LEVEL=INFO
